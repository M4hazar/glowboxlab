# Adres strony w produkcji (canonical, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://glowboxlab.com

# Wysyłka zapytań o wycenę przez Resend (https://resend.com).
# Bez klucza lokalnie zapytanie trafia do konsoli, a w produkcji formularz zwraca błąd.
RESEND_API_KEY=
# Skrzynka, na którą przychodzą zapytania.
QUOTE_TO_EMAIL=
# Nadawca ze zweryfikowanej domeny w Resend, np. GlowBox Lab <quotes@glowboxlab.com>.
QUOTE_FROM_EMAIL=

# Tylko testy e2e: zapytanie jest logowane zamiast wysyłane, także w buildzie produkcyjnym.
# QUOTE_DRY_RUN=1
